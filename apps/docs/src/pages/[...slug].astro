---
import { getDocsPage, getDocsStaticPaths, getTOC, stripBase } from '@cloudflare/nimbus-docs/runtime'
import { components } from '../components'
import DocsLayout from '../layouts/docs.astro'
import HomeLayout from '../layouts/home.astro'
import { getSiteBreadcrumbs, getSitePrevNext, getSiteSidebar } from '../lib/navigation'
import { alternatePath, isChinese } from '../lib/locale'

export const prerender = true
export const getStaticPaths = getDocsStaticPaths

const page = await getDocsPage(Astro)
if (page instanceof Response) {
  return page
}
const { entry, Content, headings, markdownUrl } = page
const pathname = stripBase(Astro.url.pathname, import.meta.env.BASE_URL)
const chinese = isChinese(pathname)
const sidebar = getSiteSidebar(pathname, chinese)
const home = pathname === '/zh/' || pathname === '/en/'
const Layout = home ? HomeLayout : DocsLayout
const toc = entry.data.tableOfContents === false ? false : getTOC(headings, entry.data.tableOfContents)
const sourcePath = entry.filePath?.replaceAll('\\', '/').split('src/content/docs/')[1]
const editUrl = sourcePath ? `https://github.com/weapp-stylex/weapp-stylex/edit/main/apps/docs/src/content/docs/${sourcePath}` : undefined
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={entry.data.sidebar === false ? false : sidebar}
  headings={toc}
  markdownUrl={markdownUrl}
  breadcrumbs={getSiteBreadcrumbs(pathname, chinese)}
  prevNext={getSitePrevNext(pathname, chinese)}
  editUrl={editUrl}
  collection={entry.collection}
  entryId={entry.id}
  noindex={entry.data.noindex}
  draft={entry.data.draft}
  searchable={entry.data.searchable}
  chinese={chinese}
  alternate={alternatePath(pathname)}
>
  <Content components={components} />
</Layout>
