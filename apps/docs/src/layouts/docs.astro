---
import type { DocsPageProps } from '@cloudflare/nimbus-docs/types'
import Head from '../components/head.astro'
import Icon from '../components/icon.astro'
import Sidebar from '../components/sidebar.astro'
import SiteFooter from '../components/site-footer.astro'
import SiteHeader from '../components/site-header.astro'
import SiteTools from '../components/site-tools.astro'
import '../styles/site.css'

type Props = DocsPageProps & { chinese: boolean, alternate: string }
const { title, description, sidebar, headings, markdownUrl, chinese, alternate, noindex, draft, searchable, breadcrumbs, prevNext, editUrl } = Astro.props
const indexUrl = chinese ? '/zh/llms.txt' : '/llms.txt'
---

<!doctype html>
<html lang={chinese ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head title={title} description={description} markdownUrl={markdownUrl} noindex={noindex || draft} chinese={chinese} />
    <link rel="alternate" hreflang={chinese ? 'en' : 'zh-CN'} href={new URL(alternate, Astro.site)} />
    <link rel="alternate" type="text/plain" href={indexUrl} title={chinese ? '文档索引' : 'Documentation index'} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{chinese ? '跳转到正文' : 'Skip to content'}</a>
    <SiteHeader chinese={chinese} alternate={alternate} current={Astro.url.pathname} mobileNav={sidebar !== false} />
    <div class="docs-grid">
      {sidebar !== false && <aside class="site-rail">
        <details class="site-navigation" open>
          <summary><Icon name="menu" />{chinese ? '文档导航' : 'Documentation navigation'}</summary>
          <nav aria-label={chinese ? '站点导航' : 'On this site'}><Sidebar items={sidebar} /></nav>
        </details>
        <a class="index-link" href={indexUrl}><Icon name="terminal" size={16} />llms.txt<Icon name="external" size={16} /></a>
      </aside>}
      <main class="doc-content" id="main-content" tabindex="-1">
        {breadcrumbs.length > 0 && <nav aria-label={chinese ? '当前位置' : 'Breadcrumbs'}><ol class="breadcrumbs">
          {breadcrumbs.map((crumb, index) => <li>{crumb.href && index < breadcrumbs.length - 1 ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>{crumb.label}</span>}</li>)}
        </ol></nav>}
        <div data-pagefind-body={searchable !== false && !noindex && !draft ? '' : undefined} data-pagefind-ignore={searchable === false || noindex || draft ? '' : undefined}>
          <h1>{title}</h1>
          {description && <p class="description">{description}</p>}
          <article><slot /></article>
        </div>
        <div class="doc-actions">
          {editUrl && <a href={editUrl}><Icon name="github" size={18} />{chinese ? '在 GitHub 编辑此页' : 'Edit this page on GitHub'}</a>}
          {markdownUrl && <a href={markdownUrl}><Icon name="book" size={18} />{chinese ? '阅读 Markdown' : 'Read Markdown'}</a>}
        </div>
        <nav class="prev-next" aria-label={chinese ? '继续阅读' : 'Continue reading'}>
          {prevNext.prev ? <a href={prevNext.prev.href}><span>{chinese ? '上一页' : 'Previous'}</span><strong>{prevNext.prev.label}</strong></a> : <span />}
          {prevNext.next && <a href={prevNext.next.href}><span>{chinese ? '下一页' : 'Next'}</span><strong>{prevNext.next.label}</strong></a>}
        </nav>
      </main>
      {headings !== false && headings.length > 0 && <aside class="page-rail"><nav aria-label={chinese ? '本页目录' : 'On this page'}>
        <p class="rail-title">{chinese ? '本页目录' : 'On this page'}</p>
        <ul class="toc-list">{headings.map(heading => <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </nav></aside>}
    </div>
    {sidebar !== false && <dialog id="mobile-navigation" class="mobile-navigation" aria-labelledby="mobile-navigation-title">
      <div class="mobile-navigation-heading"><strong id="mobile-navigation-title">{chinese ? '文档导航' : 'Documentation navigation'}</strong><button type="button" class="icon-button" data-menu-close aria-label={chinese ? '关闭导航' : 'Close navigation'}><Icon name="close" /></button></div>
      <nav aria-label={chinese ? '站点导航' : 'On this site'}><Sidebar items={sidebar} /></nav>
    </dialog>}
    <SiteFooter chinese={chinese} />
    <SiteTools chinese={chinese} />
  </body>
</html>

<script>
  import { mountSite } from '../lib/site-client'

  mountSite()
</script>
