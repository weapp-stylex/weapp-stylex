---
import Icon from './icon.astro'

interface Props { title?: string, type?: 'note' | 'tip' | 'warning' | 'caution' }
const { title, type = 'note' } = Astro.props
const icon = type === 'tip' ? 'lightning' : type === 'warning' || type === 'caution' ? 'warning' : 'book'
---

<aside class:list={['callout', `callout-${type}`]}>
  <div class="callout-heading"><Icon name={icon} />{title && <strong>{title}</strong>}</div>
  <div class="callout-content"><slot /></div>
</aside>
