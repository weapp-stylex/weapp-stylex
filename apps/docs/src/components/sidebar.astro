---
import type { SidebarItem } from '@cloudflare/nimbus-docs/types'
import Icon from './icon.astro'

interface Props { items: SidebarItem[] }
const { items } = Astro.props
function active(item: SidebarItem): boolean {
  return item.type === 'group' ? Boolean(item.indexIsCurrent || item.children.some(active)) : Boolean(item.type === 'link' && item.isCurrent)
}
---

<ul class="navigation-list">
  {items.map(item => <li class:list={{ 'navigation-group': item.type === 'group' }}>
    {item.type === 'group' ? <details open={!item.collapsed || active(item)}>
      <summary><Icon name={item.icon || 'book'} size={18} /><span>{item.label}</span></summary>
      <Astro.self items={item.children} />
    </details> : <a href={item.href} aria-current={item.type === 'link' && item.isCurrent ? 'page' : undefined}>{item.label}</a>}
  </li>)}
</ul>
