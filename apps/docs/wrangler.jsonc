{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weapp-stylex-docs",
  "account_id": "2db8e8dc78d5ffdd9fe579a7188b7826",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "stylex.weapp.dev", "custom_domain": true }]
}
