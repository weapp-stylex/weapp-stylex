{
  "name": "wechat-wevu",
  "type": "module",
  "version": "0.0.3",
  "private": true,
  "description": "Runnable multi-platform StyleX integration example",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-stylex/weapp-stylex.git",
    "directory": "examples/wechat-wevu"
  },
  "bugs": {
    "url": "https://github.com/weapp-stylex/weapp-stylex/issues"
  },
  "keywords": [
    "repoctl",
    "typescript",
    "library",
    "template"
  ],
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "build": "corepack pnpm build:weapp && corepack pnpm build:alipay && corepack pnpm build:tt && corepack pnpm build:web",
    "dev": "weapp-vite dev -p weapp",
    "typecheck": "weapp-vite prepare -p weapp && vue-tsc -p tsconfig.json --noEmit",
    "test:headless": "node test/headless.mjs",
    "build:weapp": "weapp-vite build -p weapp --outDir dist && node ../../scripts/project-config.mjs dist wechat-wevu weapp",
    "build:alipay": "weapp-vite build -p alipay --outDir dist/alipay",
    "build:tt": "weapp-vite build -p tt --outDir dist/tt",
    "build:web": "weapp-vite build -p web --outDir dist/web",
    "dev:web": "node ../wechat-native/scripts/dev-web.mjs",
    "dev:h5": "node ../wechat-native/scripts/dev-web.mjs"
  },
  "dependencies": {
    "weapp-stylex": "workspace:*",
    "wevu": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "miniprogram-api-typings": "^5.2.3",
    "vue-tsc": "^3.3.12",
    "weapp-vite": "7.4.0"
  }
}
