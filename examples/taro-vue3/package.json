{
  "name": "taro-vue3",
  "type": "module",
  "version": "0.0.4",
  "private": true,
  "description": "Runnable multi-platform StyleX integration example",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-stylex/weapp-stylex.git",
    "directory": "examples/taro-vue3"
  },
  "bugs": {
    "url": "https://github.com/weapp-stylex/weapp-stylex/issues"
  },
  "keywords": [
    "repoctl",
    "typescript",
    "library",
    "template"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "corepack pnpm build:weapp && corepack pnpm build:alipay && corepack pnpm build:tt && corepack pnpm build:h5",
    "build:webpack": "node ../../scripts/build-taro.mjs webpack",
    "build:vite": "node ../../scripts/build-taro.mjs vite",
    "dev": "node ../../scripts/build-taro.mjs vite --watch",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "build:weapp": "node ../../scripts/build-taro.mjs webpack weapp && node ../../scripts/build-taro.mjs vite weapp",
    "build:alipay": "node ../../scripts/build-taro.mjs webpack alipay && node ../../scripts/build-taro.mjs vite alipay",
    "build:tt": "node ../../scripts/build-taro.mjs webpack tt && node ../../scripts/build-taro.mjs vite tt",
    "build:h5": "node ../../scripts/build-taro.mjs webpack h5 && node ../../scripts/build-taro.mjs vite h5",
    "dev:h5": "node ../../scripts/build-taro.mjs vite h5 --watch",
    "dev:h5:webpack": "node ../../scripts/build-taro.mjs webpack h5 --watch"
  },
  "dependencies": {
    "@tarojs/components": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "vue": "^3.5.44",
    "weapp-stylex": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-vue3": "4.3.0",
    "@tarojs/plugin-platform-alipay": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-tt": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "babel-preset-taro": "4.3.0",
    "less": "^4.9.1",
    "sass": "^1.105.1",
    "vite": "^4.5.14",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.13",
    "webpack": "5.91.0"
  }
}
