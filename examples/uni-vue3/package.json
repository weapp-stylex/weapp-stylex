{
  "name": "uni-vue3",
  "type": "module",
  "version": "0.0.3",
  "private": true,
  "description": "Runnable multi-platform StyleX integration example",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-stylex/weapp-stylex.git",
    "directory": "examples/uni-vue3"
  },
  "bugs": {
    "url": "https://github.com/weapp-stylex/weapp-stylex/issues"
  },
  "keywords": [
    "repoctl",
    "typescript",
    "library",
    "template"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "build": "corepack pnpm build:weapp && corepack pnpm build:alipay && corepack pnpm build:tt && corepack pnpm build:h5",
    "dev": "uni -p mp-weixin",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "build:weapp": "uni build -p mp-weixin && node ../../scripts/project-config.mjs dist/build/mp-weixin uni-vue3 weapp",
    "build:alipay": "uni build -p mp-alipay",
    "build:tt": "uni build -p mp-toutiao",
    "build:h5": "uni build -p h5",
    "dev:h5": "uni -p h5"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030120260930001",
    "vue": "3.4.21",
    "weapp-stylex": "workspace:*"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@types/node": "^26.6.4",
    "vite": "5.2.8",
    "vue-tsc": "^3.3.12"
  }
}
