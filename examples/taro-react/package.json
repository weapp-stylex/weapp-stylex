{
  "name": "taro-react",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "description": "Runnable WeChat StyleX integration example",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-stylex/weapp-stylex.git",
    "directory": "examples/taro-react"
  },
  "bugs": {
    "url": "https://github.com/weapp-stylex/weapp-stylex/issues"
  },
  "keywords": [
    "repoctl",
    "typescript",
    "library",
    "template"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "build": "corepack pnpm build:webpack && corepack pnpm build:vite",
    "build:webpack": "node ../../scripts/build-taro.mjs webpack",
    "build:vite": "node ../../scripts/build-taro.mjs vite",
    "dev": "node ../../scripts/build-taro.mjs vite --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "weapp-stylex": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-preset-taro": "4.3.0",
    "less": "^4.9.1",
    "sass": "^1.105.1",
    "vite": "^4.5.14",
    "webpack": "5.91.0"
  }
}
