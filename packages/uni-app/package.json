{
  "name": "@weapp-stylex/uni-app",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "StyleX build integration for WeChat mini-programs",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-stylex/weapp-stylex.git",
    "directory": "packages/uni-app"
  },
  "bugs": {
    "url": "https://github.com/weapp-stylex/weapp-stylex/issues"
  },
  "keywords": [
    "repoctl",
    "typescript",
    "library",
    "template"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts"
  },
  "peerDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001"
  },
  "peerDependenciesMeta": {
    "@dcloudio/vite-plugin-uni": {
      "optional": true
    }
  },
  "dependencies": {
    "@weapp-stylex/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
