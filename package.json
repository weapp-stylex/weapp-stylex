{
  "name": "weapp-stylex-workspace",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tooling.json --pretty false && corepack pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "commitlint": "commitlint --edit",
    "test:deps": "node scripts/verify-dependency-overrides.mjs && node scripts/test-security-overrides.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "test:h5": "node scripts/test-h5.mjs",
    "test:ide": "node scripts/test-ide.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:deploy:preview": "node scripts/deploy-docs.mjs preview",
    "docs:deploy:stable": "node scripts/deploy-docs.mjs stable",
    "test:docs-deployment": "node --test scripts/docs-deployment/*.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/config-inspector": "^3.5.0",
    "@mpcore/test": "1.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "~5.1.0",
    "eslint": "^10.14.0",
    "execa": "^10.2.1",
    "lefthook": "2.2.2",
    "miniprogram-automator": "0.13.0",
    "only-allow": "^1.2.2",
    "playwright": "1.64.1",
    "repoctl": "6.3.2",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.4",
    "tsd": "^0.33.0",
    "tsdown": "0.23.4",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vitest": "~5.1.0",
    "yaml": "^2.9.1"
  }
}
