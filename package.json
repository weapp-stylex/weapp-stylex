{
  "name": "weapp-stylex-workspace",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tooling.json --pretty false && corepack pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "commitlint": "commitlint --edit",
    "test:deps": "node scripts/verify-dependency-overrides.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "test:h5": "node scripts/test-h5.mjs",
    "test:ide": "node scripts/test-ide.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/config-inspector": "^3.5.0",
    "@mpcore/test": "1.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "^10.12.0",
    "execa": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "miniprogram-automator": "0.12.1",
    "only-allow": "^1.2.2",
    "playwright": "1.64.1",
    "repoctl": "5.10.3",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.23.1",
    "turbo": "^2.11.8",
    "typescript": "6.0.3",
    "vitest": "~5.0.5",
    "yaml": "^2.9.1"
  }
}
